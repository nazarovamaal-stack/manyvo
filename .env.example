# Copy this file to .env. Keep real values only in .env.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Demo moderation requires explicit DEMO_MODE=true. It never replaces API failures.
DEMO_MODE=false
SEED_DEMO=true
# Local-only compose database password. Set a new value before first startup if needed.
POSTGRES_PASSWORD=manyvo-local-only
